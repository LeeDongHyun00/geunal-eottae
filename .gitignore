# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Local settings and secrets never belong in git (docs/parts/infra.md §10)
.env
.env.*
!.env.example
.claude/settings.local.json

# Pinned tools downloaded by scripts/tool.sh
.tools/

# Terraform: providers and state never belong in git; the lock file does
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Written wherever an Erlang VM crashes, e.g. when a mix command's output pipe closes early
erl_crash.dump

# Each part ignores its own build output in its directory (core/target, server/api/build, server/gateway/_build, ...).
