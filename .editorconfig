# Shared defaults for every part. Language formatters (rustfmt, ktlint, mix format) still decide their own files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,kt,kts,java,swift}]
indent_size = 4

[Makefile]
indent_style = tab
