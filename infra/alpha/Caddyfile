# infra/alpha/Caddyfile: TLS in front of the API (docs/parts/infra.md §2). Caddy gets and renews the Let's Encrypt
# certificate for GEUNAL_API_HOST through port 80 and passes every request to the API on the compose network.
{
	# The ACG opens TCP 80 and 443 only, so HTTP/3 over UDP would never arrive; do not advertise it. HTTP/2 stays off
	# until a Caddy image built with the fix for CVE-2026-78669 (an HTTP/2 frame flood) is published: bring it back
	# with that bump (infra/alpha/.trivyignore). The apps and browsers talk HTTP/1.1 just as well.
	servers {
		protocols h1
	}
}

{$GEUNAL_API_HOST} {
	# Browsers pass through this host in Android's Apple sign-in and on the App Link pages; HSTS keeps them on HTTPS
	# even on a network that rewrites DNS or strips TLS.
	header Strict-Transport-Security "max-age=31536000"
	# Refuses a body over 512 KB with 413 before the API reads it, so a large body cannot fill the API's small heap.
	# The largest body a device sends is a commit with its group info and welcome, each at most 64 KiB and base64 in
	# JSON, about 270 KB; backups go straight to object storage through presigned URLs.
	request_body {
		max_size 512KB
	}
	reverse_proxy api:8080
}
