# infra/alpha/Caddyfile: TLS in front of the API and the realtime gateway (docs/parts/infra.md §2). Caddy gets and
# renews the Let's Encrypt certificates for GEUNAL_API_HOST and GEUNAL_RT_HOST through port 80 and passes every request
# to the API or the gateway on the compose network.
#
# A device's WebSocket URL carries its access token in the query (protocol §7), so no request URI may reach a log
# with it: no site has a `log` directive, so Caddy writes no access log, and the default logger below drops the
# `token` query from the requests that its error entries carry (a 502 while the gateway restarts, for one).
{
	# The ACG opens TCP 80 and 443 only, so HTTP/3 over UDP would never arrive; do not advertise it. HTTP/2 stays off
	# until a Caddy image built with the fix for CVE-2026-78669 (an HTTP/2 frame flood) is published: bring it back
	# with that bump (infra/alpha/.trivyignore). The apps and browsers talk HTTP/1.1 just as well.
	servers {
		protocols h1
	}
	log default {
		format filter {
			request>uri query {
				delete token
			}
		}
	}
}

{$GEUNAL_API_HOST} {
	# Browsers pass through this host in Android's Apple sign-in and on the App Link pages; HSTS keeps them on HTTPS
	# even on a network that rewrites DNS or strips TLS.
	header Strict-Transport-Security "max-age=31536000"
	# Refuses a body over 512 KB with 413 before the API reads it, so a large body cannot fill the API's small heap.
	# The largest body a device sends is a commit with its group info and welcome, each at most 64 KiB and base64 in
	# JSON, about 270 KB; backups go straight to object storage through presigned URLs.
	request_body {
		max_size 512KB
	}
	reverse_proxy api:8080
}

{$GEUNAL_RT_HOST} {
	header Strict-Transport-Security "max-age=31536000"
	# A device sends the WebSocket upgrade and small frames only (the gateway caps a frame at 16 KB), so any request
	# body is refused here.
	request_body {
		max_size 16KB
	}
	# Caddy passes the upgrade through and puts no idle limit on the open WebSocket; the 30-second heartbeats keep it
	# alive (docs/parts/gateway.md §6 asks for at least 120 seconds).
	reverse_proxy gateway:4000
}
